# Copia questo file in ".env" e inserisci i tuoi valori reali.
# Non condividere MAI il file ".env" compilato con nessuno.

# Chiave segreta Stripe (Developers > API keys)
# In test: inizia con sk_test_...
# In produzione (soldi veri): inizia con sk_live_...
STRIPE_SECRET_KEY=

# Segreto di firma del webhook (lo ottieni quando crei l'endpoint
# webhook nel pannello Stripe, vedi README.md)
STRIPE_WEBHOOK_SECRET=

# Dominio del tuo negozio Shopify, es: outfitdelcalcio.myshopify.com
SHOPIFY_STORE=

# ID Client e Segreto della tua app Shopify (li trovi nella sezione
# "Impostazioni" della tua app su dev.shopify.com/dashboard)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Porta su cui gira il server (di solito non serve modificarla)
PORT=3000
